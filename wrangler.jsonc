{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinamealsproduct",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  // nodejs_compat: Next.js và supabase-js cần API của Node trên Workers.
  // global_fetch_strictly_public: fetch trong worker đi ra ngoài như request
  // công khai, tránh tự gọi vòng lại chính worker.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Giữ luôn địa chỉ *.workers.dev làm đường dự phòng để test khi tên miền
  // chính có sự cố. Khai báo route sẽ tự tắt nó nếu không bật lại ở đây.
  "workers_dev": true,
  // Tên miền thật. Dùng route (không phải custom_domain) vì zone đã proxy sẵn
  // qua Cloudflare — route chặn request trước khi nó đi tiếp tới origin cũ,
  // nên không cần sửa bản ghi DNS nào.
  "routes": [
    { "pattern": "vinamealsupplies.com/*", "zone_name": "vinamealsupplies.com" },
    { "pattern": "www.vinamealsupplies.com/*", "zone_name": "vinamealsupplies.com" }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Worker render PDF invoice (tách riêng vì pdf-lib không nhét vừa 3 MiB gói
  // Free). URL công khai; INVOICE_PDF_SECRET là secret set qua wrangler.
  "vars": {
    "INVOICE_PDF_URL": "https://vinameals-invoice-pdf.vinameals.workers.dev/render"
  },
  // Rate limiting ở biên cho các đường nhạy cảm (xem lib/rate-limit.ts).
  // namespace_id là số tự đặt, chỉ cần duy nhất trong worker này.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    { "name": "RL_MUTATION", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
